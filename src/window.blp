using Gtk 4.0;
using Adw 1;

template $CommodusWindow: Adw.ApplicationWindow {
  title: _("Commodus");
  default-width: 1050;
  default-height: 700;

  content: Adw.ToastOverlay toast_overlay {
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        [start]
        ToggleButton show_sidebar_btn {
          active: bind split_view.show-sidebar;
          icon-name: "sidebar-show-symbolic";
          tooltip-text: _("Toggle Sidebar (Ctrl+S)");
        }

        [end]
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: primary_menu;
        }
      }

      [top]
      Adw.Banner network_banner {
        title: _("Offline: Using cached database.");
        button-label: _("Retry");
        revealed: false;
        button-style: suggested;
      }

      Adw.OverlaySplitView split_view {
        collapsed: true;
        show-sidebar: bind show_sidebar_btn.active;
        min-sidebar-width: 350;
        max-sidebar-width: 400;

        sidebar: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            title-widget: Label {
              label: _("Setup & Filters");
              styles ["heading"]
            };
            show-end-title-buttons: false;
            show-start-title-buttons: false;
          }

          content: ScrolledWindow {
            hscrollbar-policy: never;

            Adw.Clamp {
              maximum-size: 380;
              margin-top: 10;
              margin-bottom: 10;
              margin-start: 10;
              margin-end: 10;

              Box {
                orientation: vertical;
                spacing: 14;
                margin-start: 16;
                margin-end: 16;

                // Curriculum Preset Group
                Adw.PreferencesGroup {
                  title: _("Curriculum Preset");

                  Adw.ComboRow major_combo {
                    title: _("Major");
                  }

                  Adw.ComboRow semester_combo {
                    title: _("Semester");
                    sensitive: false;
                  }
                }

                // Courses Selection Group
                Adw.PreferencesGroup {
                  title: _("Courses");

                  [header-suffix]
                  Button clear_sec {
                    icon-name: "user-trash-symbolic";
                    tooltip-text: _("Clear Selection");
                    styles ["flat","destructive-action"]
                  }

                  SearchEntry searchentry {
                    placeholder-text: _("Search courses...");
                    margin-bottom: 7;
                  }

                  ScrolledWindow {
                    propagate-natural-height: false;
                    height-request: 220;
                    hscrollbar-policy: never;
                    vscrollbar-policy: automatic;
                    styles ["card"]

                    ListBox listbox {
                      selection-mode: none;
                      styles ["boxed-list"]
                    }
                  }

                  ProgressBar numcourses {
                    fraction: 0.0;
                    text: _("0/7");
                    show-text: true;
                    margin-top: 14;
                  }
                }

                // Constraints Group
                Adw.PreferencesGroup {
                  title: _("Constraints");

                  Adw.ExpanderRow {
                    title: _("Exclude Days");
                    show-enable-switch: false;

                    Box {
                      halign: center;
                      margin-top: 6;
                      margin-bottom: 6;
                      styles ["linked"]

                      ToggleButton checksun { label: _("S"); tooltip-text: _("Sunday"); styles ["circular"] }
                      ToggleButton checkmon { label: _("M"); tooltip-text: _("Monday"); styles ["circular"] }
                      ToggleButton checktue { label: _("T"); tooltip-text: _("Tuesday"); styles ["circular"] }
                      ToggleButton checkwed { label: _("W"); tooltip-text: _("Wednesday"); styles ["circular"] }
                      ToggleButton checkthu { label: _("T"); tooltip-text: _("Thursday"); styles ["circular"] }
                      ToggleButton checkfri { label: _("F"); tooltip-text: _("Friday"); styles ["circular"] }
                      ToggleButton checksat { label: _("S"); tooltip-text: _("Saturday"); styles ["circular"] }
                    }
                  }

                  Adw.ExpanderRow time {
                    title: _("Time Boundary");
                    show-enable-switch: true;
                    enable-expansion: false;

                    Adw.ActionRow {
                      title: _("Start Time");
                      [suffix]
                      Box {
                        valign: center;
                        spacing: 4;

                        SpinButton start_hours {
                          wrap: true;
                          adjustment: Adjustment { lower: 0; upper: 23; step-increment: 1; value: 0; };
                        }

                        Label { label: ":"; }

                        SpinButton start_minutes {
                          wrap: true;
                          adjustment: Adjustment { lower: 0; upper: 59; step-increment: 15; value: 0; };
                        }
                      }
                    }

                    Adw.ActionRow {
                      title: _("End Time");
                      [suffix]
                      Box {
                        valign: center;
                        spacing: 4;

                        SpinButton end_hours {
                          wrap: true;
                          adjustment: Adjustment { lower: 0; upper: 23; step-increment: 1; value: 23; };
                        }

                        Label { label: ":"; }

                        SpinButton end_minutes {
                          wrap: true;
                          adjustment: Adjustment { lower: 0; upper: 59; step-increment: 15; value: 59; };
                        }
                      }
                    }
                  }

                  Adw.ExpanderRow gap_time {
                    title: _("Specify Gap");
                    show-enable-switch: true;
                    enable-expansion: false;

                    Adw.ComboRow gap_day {
                      title: _("Day");
                      model: StringList {
                        strings [
                          "All Days",
                          "Sunday",
                          "Monday",
                          "Tuesday",
                          "Wednesday",
                          "Thursday",
                          "Friday",
                          "Saturday"
                        ]
                      };
                    }

                    Adw.ActionRow {
                      title: _("Gap Start");
                      [suffix]
                      Box {
                        valign: center;
                        spacing: 4;

                        SpinButton gap_start_hours {
                          wrap: true;
                          adjustment: Adjustment { lower: 0; upper: 23; step-increment: 1; value: 0; };
                        }

                        Label { label: ":"; }

                        SpinButton gap_start_minutes {
                          wrap: true;
                          adjustment: Adjustment { lower: 0; upper: 59; step-increment: 15; value: 0; };
                        }
                      }
                    }

                    Adw.ActionRow {
                      title: _("Gap End");
                      [suffix]
                      Box {
                        valign: center;
                        spacing: 4;

                        SpinButton gap_end_hours {
                          wrap: true;
                          adjustment: Adjustment { lower: 0; upper: 23; step-increment: 1; value: 0; };
                        }

                        Label { label: ":"; }

                        SpinButton gap_end_minutes {
                          wrap: true;
                          adjustment: Adjustment { lower: 0; upper: 59; step-increment: 15; value: 0; };
                        }
                      }
                    }
                  }

                  Adw.SwitchRow ls_switch {
                    title: _("Exclude Full Classes");
                  }
                }

                // Tuning Group
                Adw.PreferencesGroup {
                  title: _("Optimization");

                  Adw.ComboRow tuner {
                    title: _("Prioritize");
                    model: StringList {
                      strings [
                        "Compact Days",
                        "Fewer Days",
                        "Shorter Days",
                        "Consistent Days"
                      ]
                    };
                  }

                  Adw.ComboRow sec_tuner {
                    title: _("Tie-Breaker");
                    model: StringList {
                      strings [
                        "None",
                        "Compact Days",
                        "Fewer Days",
                        "Shorter Days",
                        "Consistent Days"
                      ]
                    };
                  }
                }
              }
            }
          };

          // Pinned Generate Button
          [bottom]
          Box {
            orientation: vertical;
            margin-top: 8;
            margin-bottom: 8;
            margin-start: 25;
            margin-end: 25;

            Button generate {
              label: _("Generate Schedules");
              styles ["suggested-action", "pill"]
              height-request: 46;
            }
          }
        };

        content: Box {
          orientation: vertical;

          // CenterBox ensures the center widget is strictly centered horizontally
          CenterBox schedule_toolbar {
            margin-top: 10;
            margin-bottom: 10;
            margin-start: 5;
            margin-end: 12;

            [start]
            MenuButton stats_btn {
              tooltip-text: _("Schedule Statistics");
              styles ["flat"]
              sensitive: false;

              child: Box {
                spacing: 6;

                Image {
                  icon-name: "info-outline-symbolic";
                }

                Label stats_summary_label {
                  label: "";
                  styles ["caption", "heading"]
                }
              };
            }

            [center]
            Box schedule_nav_box {
              orientation: horizontal;
              spacing: 12;

              Button prev_btn {
                icon-name: "go-previous-symbolic";
                tooltip-text: _("Previous Schedule (Left Arrow)");
                styles ["circular", "flat"]
                sensitive: false;
              }

              Label schedule_counter_label {
                label: _("No schedules generated");
                styles ["title-4"]
              }

              Button next_btn {
                icon-name: "go-next-symbolic";
                tooltip-text: _("Next Schedule (Right Arrow)");
                styles ["circular", "flat"]
                sensitive: false;
              }
            }

            [end]
            Box {
              styles ["linked"]

              Button fav_btn {
                icon-name: "non-starred-symbolic";
                tooltip-text: _("Favorite Schedule");
                sensitive: false;
              }

              Button copy_btn {
                icon-name: "edit-copy-symbolic";
                tooltip-text: _("Copy Schedule to Clipboard (Ctrl+C)");
                sensitive: false;
              }

              Button compare_btn {
                icon-name: "view-refresh-symbolic";
                tooltip-text: _("Compare & Reschedule");
                sensitive: false;
              }

              Button import_btn {
                icon-name: "folder-download-symbolic";
                tooltip-text: _("Import Schedule");
              }
            }
          }

          ScrolledWindow schedule_scroll {
            hexpand: true;
            vexpand: true;


            Box schedule_content_box {
              orientation: vertical;
              hexpand: true;
              vexpand: true;

              Adw.StatusPage schedule_status {
                title: _("No Schedules Yet");
                description: _("Select your courses and constraints, then click Generate Schedules.");
                icon-name: "work-week-symbolic";
                hexpand: true;
                vexpand: true;
              }

              Grid schedule {
                visible: false;
                margin-top: 0;
                margin-bottom: 12;
                margin-end: 12;
                margin-start: 12;
                focusable: false;
              }
            }
          }
        };
      }
    }
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }
    item {
      label: _("Keyboard Shortcuts");
      action: "app.shortcuts";
    }
    item {
      label: _("_About Commodus");
      action: "app.about";
    }
  }
}

Adw.PreferencesDialog prefs_dialog {
  content-width: 600;
  content-height: 420;
  title: _("Preferences");

  Adw.PreferencesPage appearance_page {
    title: _("Appearance");
    icon-name: "applications-graphics-symbolic";

    Adw.PreferencesGroup {
      title: _("Color Settings");
      description: _("Change the color scheme of the application");

      Adw.SwitchRow dm_switch {
        title: _("Force Dark Mode");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Behavior");
    icon-name: "applications-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Navigation");
      description: _("Change how schedule cycling behaves");

      Adw.SwitchRow wrap_switch {
        title: _("Wrap Around Schedules");
      }
    }

    Adw.PreferencesGroup {
      title: _("Data");
      description: _("Manage saved configuration and preferences");

      Adw.ButtonRow delete_save {
        title: _("Reset All Settings");
        styles ["destructive-action"]
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Debug");
    icon-name: "dialog-warning-symbolic";

    Adw.PreferencesGroup {
      title: _("Offline Database");
      description: _("Options intended for development and local testing");

      Adw.SwitchRow local_load_switch {
        title: _("Enable Local File Picker");
      }

      Adw.ActionRow {
        title: _("Load JSON File");
        [suffix]
        Button fpickerbutton {
          label: _("Browse");
          valign: center;
          sensitive: false;
          styles ["pill"]
        }
      }
    }
  }
}