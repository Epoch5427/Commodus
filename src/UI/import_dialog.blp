using Gtk 4.0;
using Adw 1;

template $CommodusImportDialog : Adw.Dialog {
  title: _("Import Schedule");
  content-width: 655;
  content-height: 480;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_btn {
        label: _("Cancel");
      }

      [end]
      Button import_action_btn {
        label: _("Import");
        sensitive: false;
        styles ["suggested-action"]
      }
    }

    content: ScrolledWindow {
      vexpand: true;
      hscrollbar-policy: never;

      Box {
        orientation: vertical;
        spacing: 16;
        margin-top: 14;
        margin-bottom: 20;
        margin-start: 16;
        margin-end: 16;

        Adw.PreferencesGroup name_group {
          title: _("Schedule Details");
          visible: false;

          Adw.EntryRow name_row {
            title: _("Person / Label");
          }
        }

        Adw.PreferencesGroup {
          title: _("Schedule Summary Text");

          [header-suffix]
          Box {
            spacing: 4;
            valign: center;

            Button open_file_btn {
              icon-name: "folder-download-symbolic";
              tooltip-text: _("Load from PDF or Text File");
              styles ["flat"]
            }

            Button paste_btn {
              icon-name: "edit-paste-symbolic";
              tooltip-text: _("Paste from Clipboard");
              styles ["flat"]
            }
          }

          Frame {
            styles ["card"]

            ScrolledWindow {
              min-content-height: 200;
              vexpand: true;

              TextView textview {
                wrap-mode: none;
                monospace: true;
                top-margin: 10;
                bottom-margin: 10;
                left-margin: 12;
                right-margin: 12;
              }
            }
          }
        }

        ScrolledWindow {
          vscrollbar-policy: never;

          Label status_label {
            margin-bottom: 20;
            label: _("Paste Commodus or Self-Service schedule text above, or load a file.");
            halign: start;
            styles ["dim-label", "caption"]
          }
        }
      }
    };
  }
}