using Gtk 4.0;
using Adw 1;

template $CommodusImportDialog : Adw.Dialog {
  title: _("Import Schedule");
  content-width: 480;
  content-height: 460;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_btn {
        label: _("Cancel");
      }

      [end]
      Button import_action_btn {
        label: _("Import");
        sensitive: false;
        styles ["suggested-action"]
      }
    }

    content: ScrolledWindow {
      vexpand: true;
      hscrollbar-policy: never;

      Box {
        orientation: vertical;
        spacing: 16;
        margin-top: 14;
        margin-bottom: 20;
        margin-start: 16;
        margin-end: 16;

        Adw.PreferencesGroup {
          title: _("Schedule Summary Text");

          [header-suffix]
          Button paste_btn {
            icon-name: "edit-paste-symbolic";
            tooltip-text: _("Paste from Clipboard");
            valign: center;
            styles ["flat"]
          }

          Frame {
            styles ["card"]

            ScrolledWindow {
              min-content-height: 200;
              vexpand: true;

              TextView textview {
                wrap-mode: none;
                monospace: true;
                top-margin: 10;
                bottom-margin: 10;
                left-margin: 12;
                right-margin: 12;
              }
            }
          }
        }

        Label status_label {
          label: _("Paste exported schedule text above.");
          halign: start;
          styles ["dim-label", "caption"]
        }
      }
    };
  }
}