<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Epoch5427.Commodus</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Commodus</name>
  <summary>Generate conflict-free university schedules</summary>
  <description>
    <p>
      Commodus is a modern desktop application designed to solve the complexities of university scheduling.
      Built specifically for Nile University, it enables students to generate complete, conflict-free schedules
      based on their chosen courses, letting the timetable adapt to your lifestyle rather than making you adapt to it.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Blazing-fast backtrack-matching schedule solver.</li>
      <li>Custom filters for time boundaries, specific weekdays, and seat availability.</li>
      <li>Intuitive, interactive timeline grid with auto-scaling high-density cards.</li>
      <li>Granular comparative tools to lock, unlock, or swap specific sections and instructors on the fly.</li>
    </ul>
  </description>

  <developer id="io.github.Epoch5427">
    <name>Epoch</name>
  </developer>

  <url type="homepage">https://github.com/Epoch5427/Commodus</url>
  <url type="vcs-browser">https://github.com/Epoch5427/Commodus</url>
  <url type="bugtracker">https://github.com/Epoch5427/Commodus/issues</url>

  <launchable type="desktop-id">io.github.Epoch5427.Commodus.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#2e2939</color>
    <color type="primary" scheme_preference="dark">#2e2939</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://github.com/user-attachments/assets/b965d639-ecfb-41b9-b671-47f109d3000a</image>
      <caption>Interactive timeline showing a generated schedule with detailed course overlays.</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/user-attachments/assets/8fd8ffe0-5046-43bb-a059-32f4ed4b042e</image>
      <caption>Granular constraint filtering, including day exclusions and time boundaries.</caption>
    </screenshot>
  </screenshots>

    <releases>
      <release version="1.0.1" date="2026-09-17">
      <url type="details">https://github.com/Epoch5427/Commodus/releases/tag/v1.0.1</url>
      <description translate="no">
        <p>Updated GNOME Platform</p>
        <ul>
          <li>Updated to GNOME 51 runtime</li>
        </ul>
      </description>
    </release>
      <release version="1.0.0" date="2026-09-17">
      <url type="details">https://github.com/Epoch5427/Commodus/releases/tag/v1.0.0</url>
      <description translate="no">
        <p>Initial Release</p>
        <ul>
          <li>Added the ability to trigger a database update from inside the app</li>
          <li>The app now restores saved section filters correctly</li>
          <li>Fixed some bugs related to saving and loading settings</li>
          <li>The app now remembers which major you're in</li>
          <li>It is now possible to exclude full classes from only specific courses</li>
          <li>Fixed a bug related to how tutorial + lab filters were handled</li>
          <li>Added the ability to cancel generation</li>
          <li>Fixed a long standing bug where it was possible to press generate while the program was already generating schedules bugging out the program</li>
          <li>The app now resolves the 1 minute gap between classes resulting in more accurate gap readings</li>
          <li>It is now possible to either lock the lecture section or all sections when rescheduling</li>
          <li>Added the ability to customize the secondary information displayed on blocks</li>
          <li>1-hour blocks now display secondary information</li>
          <li>Redesigned the theme selector to be more modern</li>
          <li>Fixed a bunch of bugs related to the windows version</li>
        </ul>
      </description>
    </release>
      <release version="0.9.9" date="2026-09-12">
      <url type="details">https://github.com/Epoch5427/Commodus/releases/tag/v0.9.9</url>
      <description translate="no">
        <p>Bug Fixes and QoL improvements</p>
        <ul>
          <li>Fixed the exclude full classes filter so that it now takes into account tutorials and labs</li>
          <li>Fixed the database scraper UTF-8 formatting</li>
          <li>Section selection now uses checkboxes rather than radio buttons and allows for the selection of specific tutorial and or lab sections</li>
          <li>Importing a schedule now shows the exact schedule imported while still allowing the user to view alternative labs and tutorials</li>
          <li>Toasts are now dismissed when navigating favorites</li>
        </ul>
      </description>
    </release>
      <release version="0.9.8" date="2026-08-21">
      <url type="details">https://github.com/Epoch5427/Commodus/releases/tag/v0.9.8</url>
      <description translate="no">
        <p>Edge Case Optimizations</p>
        <ul>
          <li>Optimized the code to better handle extreme combination counts (400K+)</li>
          <li>Reduced memory usage by up to 83% in some extreme cases</li>
          <li>Redesigned the compare and reschedule popup to better align with the recent redesign</li>
          <li>Redesigned the import schedule popup to better align with the recent redesign</li>
          <li>Added back the network status indicator lost with the redesign</li>
        </ul>
      </description>
    </release>
      <release version="0.9.7" date="2026-08-19">
      <url type="details">https://github.com/Epoch5427/Commodus/releases/tag/v0.9.7</url>
      <description translate="no">
        <p>Major UI Redesign and Code Cleanup</p>
        <ul>
          <li>Redesigned the UI so that it's a lot more intuitive</li>
          <li>Removed a lot of now redundant code resulting in the same functionality for about 40% less code</li>
          <li>Added the ability to retry connection to the database if it fails</li>
          <li>Now using Gsettings rather than saving data in a JSON file</li>
          <li>Added the ability to favorite schedules so you can quickly switch between schedules that catch your eye</li>
          <li>Added color coding to different courses</li>
          <li>Added a simple stats counter at the top left of the schedule view</li>
          <li>It is now possible to inclusively filter by multiple instructors</li>
          <li>The scheduling engine now diagnoses which courses or tight constraints resulted in no schedules generated</li>
        </ul>
      </description>
    </release>
      <release version="0.9.6" date="2026-08-18">
      <url type="details">https://github.com/Epoch5427/Commodus/releases/tag/v0.9.6</url>
      <description translate="no">
        <p>Backend Robustness Improvements + Minor UX Improvements</p>
        <ul>
          <li>When selecting a major and semester and one or all of the required courses is missing the user is presented with a popup</li>
          <li>The courses scraper doesn't delete the database if it encounters an error</li>
          <li>The courses scraper is more resilient to errors now</li>
        </ul>
      </description>
    </release>
      <release version="0.9.5" date="2026-06-30">
      <url type="details">https://github.com/Epoch5427/Commodus/releases/tag/v0.9.5</url>
      <description translate="no">
        <p>New Features + Major Bug Fixes and UX Improvements</p>
        <ul>
          <li>Fixed the filter pop up not working for courses with a lot of sections or instructors</li>
          <li>Reworked the filters dialog to be a lot smaller and smarter. It now dynamically removes useless elements</li>
          <li>Fixed glitches that occurred as a result of using the generate shortcut before the fetch function was complete</li>
          <li>Made it so selected courses appear at the top of the courses listbox and reschedule listbox</li>
          <li>The reschedule function was reworked to use toggle buttons and checkboxes rather than drop downs in order to be more intuitive</li>
          <li>Fixed the right arrow being sensitive even when only 1 schedule is generated</li>
          <li>Fixed a longstanding bug in schedule generation for tutorials and labs with multiple meeting times</li>
          <li>Sidebar course filters now disappear when no meaningful options are found using the same logic for the pop up</li>
          <li>Added the ability to specify a specific time to be a gap for a specific day or all days</li>
          <li>The course selection screen now displays ellipsized course title as well as course code with full support for search</li>
          <li>The time boundary and specify gap functions now use an enable switch on the expander row rather than being neutralized by setting the time to 00:00</li>
          <li>Added the ability to specify two priorities rather than one through a new composite score calculation</li>
          <li>Added the ability to simply select major and semester rather than selecting courses manually</li>
          <li>Made improvements on the course fetcher in the backend resulting in automated updates for the courses database</li>
        </ul>
      </description>
    </release>
      <release version="0.9.4" date="2026-06-29">
      <url type="details">https://github.com/Epoch5427/Commodus/releases/tag/v0.9.4</url>
      <description translate="no">
        <p>UX reworks + some minor bug fixes + shortcuts</p>
        <ul>
          <li>Fixed the no schedules found screen</li>
          <li>The first time you open the app now shows the "start typing to search" screen and not the "no results found" screen</li>
          <li>The searchbar opens automatically when entering the courses page now</li>
          <li>Implemented a couple of changes to accommodate the windows port</li>
          <li>Added shortcuts for a lot of functions as well as a shortcuts dialog</li>
        </ul>
      </description>
    </release>
    <release version="0.9.3" date="2026-06-28">
      <url type="details">https://github.com/Epoch5427/Commodus/releases/tag/v0.9.3</url>
      <description translate="no">
        <p>Quality of Life Update</p>
        <ul>
          <li>Added a new state for the network status indicator to explicitly show that the app is using a cached version of the DB</li>
          <li>Removed the load data button and made it a debug option in the preferences in order not to confuse users</li>
          <li>Added white outlines to the icon to make it look better in dark mode</li>
          <li>Added a back button to the schedules page</li>
          <li>Replaced connection failed popups with a banner</li>
          <li>reworked the backend to make it return schedules in batches removing any lag prior experienced from clicking generate</li>
        </ul>
      </description>
    </release>
    <release version="0.9.2" date="2026-06-26">
      <url type="details">https://github.com/Epoch5427/Commodus/releases/tag/v0.9.2</url>
      <description translate="no">
        <p>Initial Release of Commodus</p>
        <ul>
          <li>Blazing-fast C++ backtrack-based scheduling solver backend.</li>
          <li>Modern GTK4 and Libadwaita user interface.</li>
          <li>Interactive, highly polished timeline with horizontal card expanding and smart height-scaling.</li>
          <li>On-the-fly "Compare and Reschedule" dialog to selectively lock down sections.</li>
          <li>Automatic, asynchronous remote database downloading from GitHub with local caching.</li>
          <li>Comprehensive, persistent offline state saving and configuration.</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
